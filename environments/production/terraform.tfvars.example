aws_region = "us-east-1"

# Optional custom domain. Leave both unset to use the *.cloudfront.net URL.
# domain_names    = ["quakec.studio", "www.quakec.studio"]
# route53_zone_id = "Z0123456789ABCDEFGHIJ"

# The GitHub OIDC provider is account-wide. If dev already created it
# in this account, reuse it:
# create_github_oidc_provider = false
# github_oidc_provider_arn    = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"

# Extra Actions secrets for this GitHub Environment, read from SSM SecureString
# parameters created outside Terraform:
# github_secrets = {
#   EXAMPLE_TOKEN = "/quakecstudio/production/example-token"
# }
