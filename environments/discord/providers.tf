# Only used to read the bot token from SSM Parameter Store.
provider "aws" {
  profile = "quakecstudio-admin"
  region  = var.aws_region
}

# The bot token can't be generated by Terraform: it comes from the
# application's Bot page in the Discord Developer Portal. Create the parameter
# first, or every plan of this root fails:
#   aws ssm put-parameter --profile quakecstudio-admin --type SecureString \
#     --name /quakecstudio/discord/bot-token --value '...'
data "aws_ssm_parameter" "bot_token" {
  name            = "/quakecstudio/discord/bot-token"
  with_decryption = true
}

provider "discord" {
  token            = data.aws_ssm_parameter.bot_token.value
  audit_log_reason = "Managed by Terraform (quakecstudio/infra)"
}
